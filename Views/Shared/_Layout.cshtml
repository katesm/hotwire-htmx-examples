<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hotwire MVC Lab</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/hotwire-turbo-stimulus-demo.styles.css" asp-append-version="true" />
    <script type="module" src="https://cdn.jsdelivr.net/npm/@@hotwired/turbo@8.0.12/dist/turbo.es2017-esm.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.4/dist/htmx.min.js"></script>
    <script type="module" src="~/js/site.js" asp-append-version="true"></script>
</head>
<body class="min-h-screen bg-slate-100 font-sans text-slate-900">
    <header class="border-b border-slate-200 bg-white">
        <nav class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
            <a class="font-bold tracking-tight text-slate-900" asp-controller="Home" asp-action="Index">Hotwire MVC Lab</a>
            <div class="flex items-center gap-6 text-sm">
                <a class="text-slate-600 hover:text-slate-900" asp-controller="Home" asp-action="Index">Lab</a>
                <a class="text-slate-600 hover:text-slate-900" asp-controller="Students" asp-action="Index">Students</a>
                <a class="text-slate-600 hover:text-slate-900" asp-controller="Employees" asp-action="Index">Employees</a>
            </div>
        </nav>
    </header>
    <main class="px-6">
        @RenderBody()
    </main>
    <dialog id="modal" class="w-full max-w-lg rounded-2xl p-0 shadow-2xl backdrop:bg-slate-900/50">
        <turbo-frame id="modal-content"></turbo-frame>
    </dialog>
</body>
</html>
