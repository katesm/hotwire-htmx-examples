@model IReadOnlyList<Student>

<table id="student-table" hx-swap-oob="true" class="w-full text-sm">
    <thead>
        <tr class="border-b border-slate-200 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
            <th class="pb-3 pr-6">Name</th>
            <th class="pb-3 pr-6">Email</th>
            <th class="pb-3 pr-6">Course</th>
            <th class="pb-3 pr-6">Year</th>
            <th class="pb-3"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var student in Model)
        {
            <partial name="_StudentRow" model="student" />
        }
    </tbody>
</table>
