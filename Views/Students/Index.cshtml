@model IReadOnlyList<Student>
@{
    ViewData["Title"] = "Students";
}
<div hx-headers='js:{
    "RequestVerificationToken": document.querySelector("input[name=__RequestVerificationToken]")?.value
}'>
    <div class="mx-auto max-w-5xl space-y-6 py-10">
        <section class="rounded-3xl bg-slate-900 p-8 text-white shadow-xl sm:p-10">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-cyan-300">HTMX CRUD Demo</p>
            <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">University Students</h1>
            <p class="mt-4 max-w-2xl text-lg text-slate-300">
                Full create, read, update and delete - HTML over the wire with HTMX. No JSON, no full-page reloads.
            </p>
            <div class="mt-6">
                <partial name="_StudentStats" model="Model" />
            </div>
        </section>

        @Html.AntiForgeryToken()

        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="mb-6 flex items-center justify-between">
                <h2 class="text-xl font-bold text-slate-900">All Students</h2>
                <button type="button"
                        hx-get="@Url.Action("Form", "Students")"
                        hx-target="#modal-content"
                        hx-swap="innerHTML"
                        class="rounded-lg bg-cyan-600 px-4 py-2 text-sm font-semibold text-white hover:bg-cyan-700">
                    Add Student
                </button>
            </div>

            <partial name="_StudentTable" model="Model" />
        </div>
    </div>
 </div>
