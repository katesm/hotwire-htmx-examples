@model IReadOnlyList<Employee>
@{
    ViewData["Title"] = "Employees";
    var activeCount = Model.Count(e => e.Status == "Active");
    var onboardingCount = Model.Count(e => e.Status == "Onboarding" || e.Status == "Probation");
}

<div class="mx-auto max-w-5xl space-y-6 py-10">
    <section class="rounded-3xl bg-slate-900 p-8 text-white shadow-xl sm:p-10">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-cyan-300">University HR Operations</p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">Employee Dashboard</h1>
        <p class="mt-4 max-w-3xl text-lg text-slate-300">A SAP-style people and job administration table with Turbo-powered updates and Stimulus-enhanced modal workflows.</p>
   
      <!-- display as flex  -->
      <div class="flex flex-wrap gap-4 mt-6">
        <div class="rounded-xl bg-white/10 p-4 flex-1">
            <p class="text-xs uppercase tracking-wide text-cyan-200">Total Employees</p>
            <p class="mt-1 text-2xl font-bold">@Model.Count</p>
        </div>
        <div class="rounded-xl bg-white/10 p-4 flex-1">
            <p class="text-xs uppercase tracking-wide text-cyan-200">Active</p>
            <p class="mt-1 text-2xl font-bold">@activeCount</p>
        </div>
        <div class="rounded-xl bg-white/10 p-4 flex-1">
            <p class="text-xs uppercase tracking-wide text-cyan-200">Onboarding / Probation</p>
            <p class="mt-1 text-2xl font-bold">@onboardingCount</p>
        </div>
      </div>


    </section>

    <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
            <div>
                <h2 class="text-xl font-bold text-slate-900">People & Job Information</h2>
                <p class="text-sm text-slate-500">Create, edit, and remove employee records inline without a full page refresh.</p>
            </div>
            <a asp-action="Form"
               data-turbo-frame="modal-content"
               class="rounded-lg bg-cyan-600 px-4 py-2 text-sm font-semibold text-white hover:bg-cyan-700">
                Add Employee
            </a>
        </div>

        <partial name="_EmployeeTable" model="Model" />
    </section>
</div>
