@model Employee

<tr id="employee-row-@Model.Id" class="border-b border-slate-100 align-top last:border-0">
    <td class="py-3 pr-4">
        <p class="font-semibold text-slate-900">@Model.FirstName @Model.LastName</p>
        <p class="text-xs text-slate-500">@Model.EmployeeNumber</p>
        <p class="text-xs text-slate-500">@Model.Email</p>
    </td>
    <td class="py-3 pr-4 text-slate-700">@Model.Department</td>
    <td class="py-3 pr-4">
        <p class="font-medium text-slate-800">@Model.JobTitle</p>
        <p class="text-xs text-slate-500">@Model.EmploymentType · @Model.Grade</p>
        <p class="text-xs text-slate-500">@Model.Campus</p>
    </td>
    <td class="py-3 pr-4 text-slate-700">@Model.Manager</td>
    <td class="py-3 pr-4 text-slate-700">@Model.StartDate.ToString("dd MMM yyyy")</td>
    <td class="py-3 pr-4">
        <span class="inline-flex rounded-full bg-cyan-50 px-2.5 py-1 text-xs font-semibold text-cyan-700">@Model.Status</span>
    </td>
    <td class="py-3">
        <div class="flex justify-end gap-2">
            <a asp-action="Form"
               asp-route-id="@Model.Id"
               data-turbo-frame="modal-content"
               class="rounded-md bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700 hover:bg-slate-200">
                Edit
            </a>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="inline" data-turbo-confirm="Delete @Model.FirstName @Model.LastName?">
                @Html.AntiForgeryToken()
                <button type="submit" class="rounded-md bg-red-50 px-3 py-1 text-xs font-semibold text-red-700 hover:bg-red-100">
                    Delete
                </button>
            </form>
        </div>
    </td>
</tr>
