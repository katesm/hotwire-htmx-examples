@model IReadOnlyList<hotwire_turbo_stimulus_demo.Models.LearningTask>
@{
    ViewData["Title"] = "Hotwire Lab";
}

<div class="mx-auto max-w-5xl space-y-10 py-10">
    <section class="rounded-3xl bg-slate-900 p-8 text-white shadow-xl sm:p-12">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-cyan-300">ASP.NET Core MVC learning lab</p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">Hotwire + Stimulus</h1>
        <p class="mt-4 max-w-2xl text-lg text-slate-300">Server-rendered HTML with small, purposeful JavaScript enhancements.</p>
    </section>

    <div class="grid gap-6 lg:grid-cols-2">
        <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <p class="text-sm font-semibold text-cyan-700">Turbo Frames</p>
                    <h2 class="mt-1 text-2xl font-bold text-slate-900">Tasks without a full reload</h2>
                </div>
                <span class="rounded-full bg-cyan-50 px-3 py-1 text-xs font-semibold text-cyan-700">HTML over the wire</span>
            </div>
            <p class="mt-3 text-sm leading-6 text-slate-600">The form and task list target the <code>&lt;turbo-frame&gt;</code> below. MVC returns a partial view, not JSON.</p>
            <turbo-frame id="tasks" class="mt-5 block" src="@Url.Action("Tasks")">
                <p class="text-sm text-slate-500">Loading tasks...</p>
            </turbo-frame>
        </section>

        <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm" data-controller="counter">
            <p class="text-sm font-semibold text-violet-700">Stimulus</p>
            <h2 class="mt-1 text-2xl font-bold text-slate-900">A tiny client-side controller</h2>
            <p class="mt-3 text-sm leading-6 text-slate-600">Stimulus connects behavior to existing HTML through data attributes.</p>
            <div class="mt-6 flex items-center gap-4">
                <button class="rounded-lg bg-violet-100 px-4 py-2 font-semibold text-violet-800 transition hover:bg-violet-200" data-action="counter#decrement">-</button>
                <output class="min-w-12 text-center text-3xl font-bold text-slate-900" data-counter-target="count">0</output>
                <button class="rounded-lg bg-violet-600 px-4 py-2 font-semibold text-white transition hover:bg-violet-700" data-action="counter#increment">+</button>
                <button class="ml-2 text-sm font-semibold text-slate-500 underline hover:text-slate-800" data-action="counter#reset">Reset</button>
            </div>
            <pre class="mt-6 overflow-x-auto rounded-xl bg-slate-950 p-4 text-xs leading-5 text-cyan-200"><code>data-controller="counter"
data-action="counter#increment"
data-counter-target="count"</code></pre>
        </section>
    </div>

    <section class="rounded-2xl border border-amber-200 bg-amber-50 p-6">
        <h2 class="font-bold text-amber-950">Try it</h2>
        <ol class="mt-2 list-decimal space-y-1 pl-5 text-sm text-amber-900">
            <li>Add or toggle a task, then inspect the Network response.</li>
            <li>Notice the task toggle returns a <code>turbo-stream</code> that replaces only one row.</li>
            <li>Click the counter controls: no request is made because Stimulus runs in the browser.</li>
        </ol>
    </section>
</div>
